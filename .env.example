# Portable application home. By default this is <LinSub install>\runtime,
# so selecting another drive in the installer keeps all app-owned files there.
# Use this override for development or portable deployments:
# LINSUB_HOME=D:\LinSubData
# RUNTIME_DATA_DIR defaults to LINSUB_HOME\data; override only for migration.
# RUNTIME_DATA_DIR=D:\LinSubData

# Whisper transcription
# Models: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# HY-MT2 local machine translation. The model downloads into HF_HOME on first use.
HYMT2_MODEL=tencent/Hy-MT2-1.8B

# Edge TTS requests are sent concurrently. Keep this between 1 and 4.
TTS_MAX_CONCURRENCY=1

# Without LINSUB_HOME, advanced deployments may override individual caches.
# When LINSUB_HOME is set, it is a hard boundary and these are ignored so a
# machine-wide environment variable cannot silently redirect files to drive C.
# HF_HOME=D:\LinSubData\cache\huggingface
# TORCH_HOME=D:\LinSubData\cache\torch
# PIP_CACHE_DIR=D:\LinSubData\cache\pip
# UV_CACHE_DIR=D:\LinSubData\cache\uv
# LINSUB_TMP_DIR=D:\LinSubData\cache\tmp
